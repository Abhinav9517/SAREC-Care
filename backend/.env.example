PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/campus_grievance
JWT_SECRET=replace_with_a_long_random_secret_for_development_only
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
PASSWORD_RESET_ORIGIN=http://localhost:5173
UPLOAD_DIR=./private-uploads
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_MAX_FILES=5
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/webm
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional for the local bootstrap-admin CLI. Keep this out of source control.
# ADMIN_BOOTSTRAP_PASSWORD=
